{
  "name": "racing-favourite-finder",
  "version": "1.0.196",
  "private": true,
  "description": "Australian horse and greyhound racing market-favourite dashboard",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "desktop:dev": "electron .",
    "desktop:dist": "node desktop/create-icon.cjs && electron-builder --win portable",
    "test": "node --test"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "@aws-sdk/client-s3": "^3.850.0"
  },
  "main": "desktop/main.js",
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.18.1",
    "sharp": "^0.35.5"
  },
  "build": {
    "appId": "au.com.racingfavouritefinder.desktop",
    "productName": "Racing Favourite Finder",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Racing-Favourite-Finder-Setup-${version}.${ext}",
      "icon": "desktop/icon.ico"
    },
    "portable": {
      "artifactName": "CSKAFTY.${ext}"
    }
  },
  "overrides": {
    "app-builder-lib": {
      "minimatch": "^11.0.1"
    },
    "@electron/universal": {
      "minimatch": "^11.0.1"
    }
  }
}
