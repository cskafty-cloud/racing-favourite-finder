# Core server settings
PORT=3000
# Railway persistent history volume mount
DATA_DIR=/data

# Optional legacy integrations. Do not use personal-use credentials for a public board.
PUNTERSEDGE_API_KEY=
PUNTERSEDGE_PLAN=
PUNTERS_EDGE_PUBLIC_DISPLAY_LICENSED=false

# Optional Krok integration. Leave public display disabled unless written permission is in place.
KROKODDS_API_KEY=
KROKODDS_PUBLIC_DISPLAY_LICENSED=false

# Optional sports fallback. Paid fallback remains disabled unless explicitly enabled.
ODDS_DATA_API_TOKEN=
ODDS_API_BASE=https://api.odds-data-api.com
ENABLE_PAID_ODDS_FALLBACK=false

# Optional Betfair Australian adapter connection (keep secrets server-side).
BETFAIR_FEED_URL=
BETFAIR_SPORTS_FEED_URL=
BETFAIR_FEED_TOKEN=
# Only configure direct Betfair credentials where the account and deployment location are permitted.
BETFAIR_APP_KEY=
BETFAIR_SESSION_TOKEN=

# Optional R2 history backup; leave unset to use the Railway /data volume.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
